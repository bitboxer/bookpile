<script>
  window.BOOKPILE_REGIONS = <%= raw(@regions_json) %>;
  window.BOOKPILE_ISBN = "<%= @isbn %>";
  window.BOOKPILE_COUNTRY = "<%= @country %>";
  window.BOOKPILE_CITY = "<%= @city %>";
</script>

<div class="book-content" data-isbn={@isbn}>

  <%!-- Book block --%>
  <div class="book-block">
    <div class="cover-container">
      <img
        id="book-cover-img"
        src={(@book.image || "https://covers.openlibrary.org/b/isbn/#{@isbn}-L.jpg") |> String.replace("http://", "https://") |> String.replace("zoom=1", "zoom=0")}
        alt={"Cover of #{@book.title}"}
        class="book-cover-img"
        width="240"
        height="360"
      />
      <div id="cover-fallback" class="cover-fallback" style="display:none" aria-hidden="true">
        <span class="cover-format-label">
          {if @book.media_type, do: @book.media_type, else: "A Book"}
        </span>
        <svg viewBox="0 0 200 40" class="cover-wave" aria-hidden="true">
          <path d="M0 20 Q 25 0 50 20 T 100 20 T 150 20 T 200 20" fill="none" stroke="#1f1a13" stroke-width="1.2"/>
          <path d="M0 28 Q 25 8 50 28 T 100 28 T 150 28 T 200 28" fill="none" stroke="#1f1a13" stroke-width="1.2" opacity="0.4"/>
        </svg>
        <div class="cover-text-block">
          <div class="cover-title-text">{@book.title}</div>
          <div class="cover-author-text">{Enum.join(@book.authors, ", ") |> String.upcase()}</div>
        </div>
      </div>
    </div>

    <div class="book-meta">
      <span class="tiny-label ochre-label">
        {if @book.published_date, do: @book.published_date, else: ""}
      </span>
      <h1 class="book-title">{@book.title}</h1>
      <%= if @book.subtitle do %>
        <div class="book-subtitle">{@book.subtitle}</div>
      <% end %>
      <div class="book-author">by {Enum.join(@book.authors, ", ")}</div>
      <%= if @book.description do %>
        <div class="book-description-wrap">
          <p class="book-description" id="book-description">{@book.description}</p>
          <button class="show-more-btn" id="show-more-btn" type="button" style="display:none">Show more…</button>
        </div>
      <% end %>
      <div class="book-chips">
        <%= if @book.media_type do %>
          <span class="chip">{@book.media_type}</span>
        <% end %>
        <%= if @book.page_count && @book.page_count > 0 do %>
          <span class="chip">{@book.page_count} pp.</span>
        <% end %>
        <span class="chip">ISBN {@isbn}</span>
      </div>
    </div>
  </div>

  <%!-- Region bar --%>
  <div class="region-bar">
    <div class="region-label-block">
      <span class="tiny-label">You are browsing</span>
      <div class="region-city-line">
        Stockists in <em class="region-city-name">{@city}</em>
      </div>
    </div>
    <div class="region-picker-wrapper" id="region-picker-wrapper">
      <button class="region-picker-btn" id="region-picker-btn" type="button">
        <span class="picker-btn-inner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ochre)" stroke-width="1.8">
            <circle cx="12" cy="10" r="3"/>
            <path d="M12 2 a8 8 0 0 1 8 8 c0 5.5 -8 12 -8 12 s-8 -6.5 -8 -12 a8 8 0 0 1 8 -8 z"/>
          </svg>
          <span><strong>{@city}</strong>, <span>{@country}</span></span>
        </span>
        <span class="picker-change">change ▾</span>
      </button>
      <div class="region-popover" id="region-popover" style="display:none">
        <div class="popover-search-row">
          <input
            type="text"
            id="region-search"
            class="popover-search-input"
            placeholder="Search a city or country…"
            autocomplete="off"
          />
        </div>
        <div class="popover-list" id="region-list" role="listbox"></div>
      </div>
    </div>
  </div>

  <%!-- Lists area --%>
  <div class="lists-area" id="lists-area">
    <div class="list-col">
      <div class="list-header">
        <h2 class="section-heading">Bookshops</h2>
        <span class="tiny-label">{length(@local_shops) + length(@national_shops)} places</span>
      </div>
      <div id="shops-list">
        <%= if @local_shops != [] do %>
          <h3 class="list-subheading">Local</h3>
          <%= for {shop, i} <- Enum.with_index(@local_shops) do %>
            <a href={listing_url(shop, @isbn)} target="_blank" rel="noopener noreferrer"
                class="listing-row" aria-label={"Buy #{@book.title} on #{shop["name"]}"}>
              <span class="listing-index">{String.pad_leading(to_string(i + 1), 2, "0")}</span>
              <span class="listing-icon">{shop_glyph(shop)}</span>
              <span class="listing-info">
                <span class="listing-name">{shop["name"]}</span>
                <span class="listing-note">{shop["note"]}</span>
              </span>
              <span class="listing-action">{listing_domain(shop)} ↗</span>
            </a>
          <% end %>
        <% end %>
        <%= if @national_shops != [] do %>
          <h3 class={if @local_shops != [], do: "list-subheading list-subheading--gap", else: "list-subheading"}>National chains</h3>
          <%= for {shop, i} <- Enum.with_index(@national_shops) do %>
            <a href={listing_url(shop, @isbn)} target="_blank" rel="noopener noreferrer"
                class="listing-row" aria-label={"Buy #{@book.title} on #{shop["name"]}"}>
              <span class="listing-index">{String.pad_leading(to_string(i + 1), 2, "0")}</span>
              <span class="listing-icon">{shop_glyph(shop)}</span>
              <span class="listing-info">
                <span class="listing-name">{shop["name"]}</span>
                <span class="listing-note">{shop["note"]}</span>
              </span>
              <span class="listing-action">{listing_domain(shop)} ↗</span>
            </a>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="list-col">
      <div class="list-header">
        <h2 class="section-heading"><em>Libraries</em></h2>
        <span class="tiny-label">borrow, don't buy</span>
      </div>
      <div id="libraries-list">
        <%= for {lib, i} <- Enum.with_index(@libraries) do %>
          <a href={listing_url(lib, @isbn)} target="_blank" rel="noopener noreferrer"
              class="listing-row" aria-label={"Search #{lib["name"]} for #{@book.title}"}>
            <span class="listing-index">{String.pad_leading(to_string(i + 1), 2, "0")}</span>
            <span class="listing-icon">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M3 9 L12 4 L21 9"/>
                <path d="M5 9 V19 M9 9 V19 M15 9 V19 M19 9 V19"/>
                <path d="M3 20 H21"/>
              </svg>
            </span>
            <span class="listing-info">
              <span class="listing-name">{lib["name"]}</span>
              <span class="listing-note">{lib["note"]}</span>
            </span>
            <span class="listing-action">Search ↗</span>
          </a>
        <% end %>
      </div>
    </div>
    <%= if @trackers != [] do %>
      <div class="list-col list-col--full">
        <div class="list-header">
          <h2 class="section-heading">Book tracking</h2>
        </div>
        <div id="trackers-list">
          <%= for {tracker, i} <- Enum.with_index(@trackers) do %>
            <a href={listing_url(tracker, @isbn)} target="_blank" rel="noopener noreferrer"
                class="listing-row" aria-label={"Track #{@book.title} on #{tracker["name"]}"}>
              <span class="listing-index">{String.pad_leading(to_string(i + 1), 2, "0")}</span>
              <span class="listing-icon">{shop_glyph(tracker)}</span>
              <span class="listing-info">
                <span class="listing-name">{tracker["name"]}</span>
                <span class="listing-note">{tracker["note"]}</span>
              </span>
              <span class="listing-action">{listing_domain(tracker)} ↗</span>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

</div>
