<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Bookpile">
      {assigns[:page_title] || "Bookpile"}
    </.live_title>
    <meta property="og:site_name" content="Bookpile"/>
    <meta property="og:type" content={assigns[:og_type] || "website"}/>
    <meta property="og:title" content={assigns[:og_title] || "Bookpile"}/>
    <meta property="og:description" content={assigns[:og_description] || "Find the book you want at a bookshop or library near you. No affiliate links, no cookies."}/>
    <meta property="og:url" content={assigns[:og_url] || "https://bookpile.org"}/>
    <%= if assigns[:og_image] do %>
      <meta property="og:image" content={@og_image}/>
      <meta property="og:image:width" content="240"/>
      <meta property="og:image:height" content="360"/>
    <% end %>
    <%= if assigns[:og_isbn] do %>
      <meta property="book:isbn" content={@og_isbn}/>
    <% end %>
    <meta name="twitter:card" content={if assigns[:og_image], do: "summary_large_image", else: "summary"}/>
    <meta name="twitter:title" content={assigns[:og_title] || "Bookpile"}/>
    <meta name="twitter:description" content={assigns[:og_description] || "Find the book you want at a bookshop or library near you. No affiliate links, no cookies."}/>
    <%= if assigns[:og_image] do %>
      <meta name="twitter:image" content={@og_image}/>
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"}/>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}></script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
